# ═════════════════════════════════════════════════════════════════
# Streamlit Secrets 템플릿
# ═════════════════════════════════════════════════════════════════
#
# 사용법:
#   [로컬 테스트]  이 파일을 복사해서 secrets.toml로 이름 변경 후 실제 값 입력
#   [Cloud 배포]   share.streamlit.io → 앱 Settings → Secrets 에 아래 내용 붙여넣기
#
# ⚠️ 이 파일은 예시일 뿐, 실제 값이 들어간 secrets.toml은 절대 GitHub에 커밋 금지
#    (.gitignore에 이미 제외되어 있음)
#
# ═════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────
# 1. credentials.json 내용
# ─────────────────────────────────────────────────────────────────
# Google Cloud Console에서 다운받은 credentials.json을 열어서
# 그 안의 "installed" 내부 값들을 그대로 복사
# ─────────────────────────────────────────────────────────────────
[google_credentials.installed]
client_id = "1234567890-abcdefg.apps.googleusercontent.com"
project_id = "your-project-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_secret = "GOCSPX-your_secret_here"
redirect_uris = ["http://localhost"]


# ─────────────────────────────────────────────────────────────────
# 2. token.json 내용
# ─────────────────────────────────────────────────────────────────
# 로컬에서 한 번 dashboard.py를 실행해 OAuth 인증을 마치면
# 프로젝트 폴더에 token.json이 생성됨
# 그 파일을 열어서 내용을 아래 형식으로 옮겨 적기
# ─────────────────────────────────────────────────────────────────
[google_token]
token = "ya29.a0AX..."
refresh_token = "1//0g..."
token_uri = "https://oauth2.googleapis.com/token"
client_id = "1234567890-abcdefg.apps.googleusercontent.com"
client_secret = "GOCSPX-your_secret_here"
scopes = ["https://www.googleapis.com/auth/calendar"]
expiry = "2026-04-16T12:34:56.789Z"

# (token.json에 "universe_domain" 필드가 있으면 아래도 추가)
# universe_domain = "googleapis.com"